<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
    <rdfs:label>Agent</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataCatalog">
    <rdfs:label xml:lang="en">metadata catalog</rdfs:label>
    <skos:definition xml:lang="en">Relates a metadata service to a catalog whose metadata record it serves.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#MetadataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/relation"/>
    </rdfs:subPropertyOf>
    <skos:closeMatch>
      <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#catalog"/>
    </skos:closeMatch>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://w3id.org/fdp/fdp-o#">
    <rdfs:label xml:lang="en">FAIR Data Point Ontology</rdfs:label>
    <dcterms:title xml:lang="en">FAIR Data Point Ontology</dcterms:title>
    <dcterms:description xml:lang="en">This ontology defines the classes and properties that are specific to the FAIR Data Point (FDP) and their relations to the Data Catalog Vocabulary (DCAT) version 3. It is the vocabulary used by the FAIR Data Point specification to describe a FAIR Data Point and the records of the metadata it serves.</dcterms:description>
    <owl:versionIRI rdf:resource="https://w3id.org/fdp/fdp-o/2.0"/>
    <owl:versionInfo>2.0</owl:versionInfo>
    <dcterms:hasVersion>2.0</dcterms:hasVersion>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-08</dcterms:modified>
    <dcterms:creator>
      <owl:NamedIndividual rdf:about="https://github.com/kburger">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:label>Kees Burger</rdfs:label>
      </owl:NamedIndividual>
    </dcterms:creator>
    <dcterms:creator>
      <owl:NamedIndividual rdf:about="https://github.com/luizbonino">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:label>Luiz Olavo Bonino da Silva Santos</rdfs:label>
        <owl:sameAs rdf:resource="https://orcid.org/0000-0002-1164-1351"/>
      </owl:NamedIndividual>
    </dcterms:creator>
    <dcterms:creator>
      <owl:NamedIndividual rdf:about="https://github.com/rajaram5">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:label>Rajaram Kaliyaperumal</rdfs:label>
      </owl:NamedIndividual>
    </dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <rdfs:seeAlso rdf:resource="https://specs.fairdatapoint.org/"/>
    <rdfs:comment xml:lang="en">Version 2.0 aligns the ontology with version 2.0 of the FAIR Data Point specification. The namespace http://purl.org/fdp/fdp-o# used by earlier releases is deprecated in favour of https://w3id.org/fdp/fdp-o#. Terms deprecated in this version carry owl:deprecated and point to their replacement with dcterms:isReplacedBy.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#DataRecord">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#metadataIdentifier">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentProperty>
      <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataIdentifier">
        <rdfs:label xml:lang="en">metadata identifier (deprecated)</rdfs:label>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <rdfs:comment xml:lang="en">Deprecated since version 2.0. The metadata record is identified by its own IRI.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:equivalentProperty>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#metadataIssued">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentProperty>
      <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataIssued">
        <rdfs:label xml:lang="en">metadata issued (deprecated)</rdfs:label>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/issued"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/issued"/>
        <rdfs:comment xml:lang="en">Deprecated since version 2.0. State dcterms:issued on the fdp-o:MetadataRecord instead.</rdfs:comment>
      </owl:DatatypeProperty>
    </owl:equivalentProperty>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataVersion">
    <rdfs:label xml:lang="en">metadata version</rdfs:label>
    <skos:definition xml:lang="en">Version of a metadata record.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/hasVersion"/>
  <owl:Class rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#Metadata">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentClass rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#conformsToFdpSpec">
    <rdfs:label xml:lang="en">conforms to FDP specification</rdfs:label>
    <skos:definition xml:lang="en">Relates a FAIR Data Point to a conformance class of a version of the FAIR Data Point specification that it claims to conform to. A FAIR Data Point states one value per claimed conformance class, and always the FDP Core class.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/conformsTo"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#metadataModified">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentProperty>
      <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataModified">
        <rdfs:label xml:lang="en">metadata modified (deprecated)</rdfs:label>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/modified"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://purl.org/dc/terms/modified"/>
        <rdfs:comment xml:lang="en">Deprecated since version 2.0. State dcterms:modified on the fdp-o:MetadataRecord instead.</rdfs:comment>
      </owl:DatatypeProperty>
    </owl:equivalentProperty>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#servesMetadata">
    <rdfs:label xml:lang="en">serves metadata</rdfs:label>
    <skos:definition xml:lang="en">Relates a metadata service to a metadata record it serves. This is the relation that distinguishes a metadata service from other data services, in the same way as dcat:servesDataset relates a data service to the datasets it serves.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#MetadataService"/>
    <rdfs:range rdf:resource="https://w3id.org/fdp/fdp-o#MetadataRecord"/>
    <rdfs:seeAlso>
      <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#servesDataset"/>
    </rdfs:seeAlso>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isReplacedBy"/>
  <owl:ObjectProperty rdf:about="http://www.re3data.org/schema/3-0#repositoryIdentifier">
    <owl:equivalentProperty>
      <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpIdentifier">
        <rdfs:label xml:lang="en">FDP identifier</rdfs:label>
        <skos:definition xml:lang="en">An identifier of the FAIR Data Point in an external registry.</skos:definition>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
      </owl:ObjectProperty>
    </owl:equivalentProperty>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasMetadata">
    <rdfs:label xml:lang="en">has metadata</rdfs:label>
    <skos:definition xml:lang="en">Relates an entity described in a FAIR Data Point to its metadata record. The domain is deliberately not restricted to dcat:Resource: every entity of the content model of an FDP, including distributions and entities of custom classes, has a metadata record.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/fdp/fdp-o#MetadataRecord"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/isPrimaryTopicOf">
        <owl:inverseOf rdf:resource="http://xmlns.com/foaf/0.1/primaryTopic"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#isMetadataOf">
        <rdfs:label xml:lang="en">is metadata of</rdfs:label>
        <skos:definition xml:lang="en">Relates a metadata record to the entity it describes. Inverse of fdp-o:hasMetadata.</skos:definition>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#MetadataRecord"/>
        <rdfs:subPropertyOf rdf:resource="http://xmlns.com/foaf/0.1/primaryTopic"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/replaces"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
  <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#MetadataService">
    <rdfs:label xml:lang="en">Metadata service</rdfs:label>
    <skos:definition xml:lang="en">A data service that serves metadata records. Where a dcat:DataService serves datasets (dcat:servesDataset), a metadata service serves the metadata records of the entities it describes (fdp-o:servesMetadata).</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <skos:closeMatch rdf:resource="http://www.re3data.org/schema/3-0#Repository"/>
    <rdfs:comment xml:lang="en">In the context of the FAIR Data Point, fdp-o:MetadataService and re3:Repository can be treated as an exact match; the class Repository was used in version 1.0 of the FDP specification.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#Metadata">
    <rdfs:label xml:lang="en">Metadata (deprecated)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/fdp/fdp-o#MetadataRecord"/>
    <rdfs:comment xml:lang="en">Deprecated since version 2.0. Use fdp-o:MetadataRecord, which is not a subclass of dcat:Dataset.</rdfs:comment>
    <dcterms:creator rdf:resource="https://github.com/luizbonino"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T10:09:40+00:00</dcterms:created>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/date"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpEndDate">
    <rdfs:label xml:lang="en">FDP end date (deprecated)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentProperty>
      <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#endDate">
        <rdfs:label xml:lang="en">end date</rdfs:label>
        <skos:definition xml:lang="en">Date until which the FAIR Data Point is or was in operation.</skos:definition>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
        <dcterms:replaces rdf:resource="https://w3id.org/fdp/fdp-o#fdpEndDate"/>
      </owl:DatatypeProperty>
    </owl:equivalentProperty>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/fdp/fdp-o#endDate"/>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpSoftwareVersion">
    <rdfs:label xml:lang="en">FDP software version (deprecated)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:equivalentProperty>
      <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#hasSoftwareVersion">
        <rdfs:label xml:lang="en">has software version</rdfs:label>
        <skos:definition xml:lang="en">Version of the software that implements the FAIR Data Point.</skos:definition>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dcterms:replaces rdf:resource="https://w3id.org/fdp/fdp-o#fdpSoftwareVersion"/>
      </owl:DatatypeProperty>
    </owl:equivalentProperty>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/fdp/fdp-o#hasSoftwareVersion"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpUILanguage">
    <rdfs:label xml:lang="en">FDP UI language (deprecated)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dcterms:isReplacedBy>
      <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#uiLanguage">
        <rdfs:label xml:lang="en">user interface language</rdfs:label>
        <skos:definition xml:lang="en">A language of the user interface of the FAIR Data Point. Distinct from dcterms:language, which gives the language of the metadata record.</skos:definition>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/LinguisticSystem"/>
        <dcterms:replaces rdf:resource="https://w3id.org/fdp/fdp-o#fdpUILanguage"/>
      </owl:ObjectProperty>
    </dcterms:isReplacedBy>
    <rdfs:comment xml:lang="en">Deprecated since version 2.0. Use the object property fdp-o:uiLanguage with an IRI value.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#startDate">
    <rdfs:label xml:lang="en">start date</rdfs:label>
    <skos:definition xml:lang="en">Date from which the FAIR Data Point is or was in operation.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
    <dcterms:replaces>
      <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpStartDate">
        <rdfs:label xml:lang="en">FDP start date (deprecated)</rdfs:label>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <owl:equivalentProperty rdf:resource="https://w3id.org/fdp/fdp-o#startDate"/>
        <dcterms:isReplacedBy rdf:resource="https://w3id.org/fdp/fdp-o#startDate"/>
      </owl:DatatypeProperty>
    </dcterms:replaces>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#MetadataRecord">
    <rdfs:label xml:lang="en">Metadata record</rdfs:label>
    <skos:definition xml:lang="en">The record describing the registration of an entity in a FAIR Data Point: when the metadata record of the entity was created and last modified in the FDP, by whom, and which profile it conforms to. It is linked to the described entity with fdp-o:isMetadataOf. When the described entity is a dcat:Resource, the metadata record is also a dcat:CatalogRecord.</skos:definition>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.re3data.org/schema/3-0#Repository">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#FAIRDataPoint">
    <rdfs:label xml:lang="en">FAIR Data Point</rdfs:label>
    <skos:definition xml:lang="en">A metadata service that conforms to the FAIR Data Point specification: it serves metadata records with content negotiation, refers each record to its profile, and describes the structure of its metadata content with Linked Data Platform containers so that clients can navigate it.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/fdp/fdp-o#MetadataService"/>
    <skos:closeMatch rdf:resource="http://www.re3data.org/schema/3-0#Repository"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#Catalog"/>
  <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#DataService"/>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
  <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/primaryTopic"/>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#Resource"/>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person"/>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#CatalogRecord"/>
  <owl:Class rdf:about="http://purl.org/dc/terms/LinguisticSystem"/>
</rdf:RDF>
