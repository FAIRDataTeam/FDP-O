        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Create Operation</rdfs:label>
        <dct:description xml:lang="en">The provenance activity that created a metadata record.</dct:description>
    </owl:Class>
    


    <!-- https://w3id.org/fdp/fdp-o#ModifyOperation -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#ModifyOperation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modify Operation</rdfs:label>
        <dct:description xml:lang="en">The provenance activity that last modified a metadata record.</dct:description>
    </owl:Class>
    


