<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/fdp/fdp-o/"
     xml:base="http://purl.org/fdp/fdp-o/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcam="http://purl.org/dc/dcam/"
     xmlns:dcat="http://www.w3.org/ns/dcat#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:fdp-o="http://purl.org/fdp/fdp-o#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/fdp/fdp-o#">
        <owl:versionIRI rdf:resource="https://w3id.org/fdp/fdp-o#"/>
        <dct:creator rdf:resource="https://github.com/kburger"/>
        <dct:creator rdf:resource="https://github.com/luizbonino"/>
        <dct:creator rdf:resource="https://github.com/rajaram5"/>
        <dct:description xml:lang="en">This ontology describes the elements of the FAIR Data Point (FDP) and their relations. It serves as a reference model to annotate the metadata content of the FDPs.</dct:description>
        <dct:hasVersion xml:lang="en">1.0</dct:hasVersion>
        <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
        <rdfs:label xml:lang="en">FAIR Data Point Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/hasVersion -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/hasVersion"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rdf.biosemantics.org/ontologies/fdp-o#metadataIdentifier -->

    <owl:ObjectProperty rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#metadataIdentifier">
        <owl:equivalentProperty rdf:resource="https://w3id.org/fdp/fdp-o#metadataIdentifier"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/fdp/fdp-o#deprecatedObjectProperties"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- http://www.re3data.org/schema/3-0#repositoryIdentifier -->

    <owl:ObjectProperty rdf:about="http://www.re3data.org/schema/3-0#repositoryIdentifier">
        <owl:equivalentProperty rdf:resource="https://w3id.org/fdp/fdp-o#fdpIdentifier"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#catalog -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#catalog"/>
    


    <!-- http://www.w3.org/ns/dcat#servesDataset -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#servesDataset"/>
    


    <!-- https://w3id.org/fdp/fdp-o#deprecatedObjectProperties -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#deprecatedObjectProperties"/>
    


    <!-- https://w3id.org/fdp/fdp-o#fdpIdentifier -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasMetadata -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasMetadata">
        <owl:inverseOf rdf:resource="https://w3id.org/fdp/fdp-o#isMetadataOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:range rdf:resource="https://w3id.org/fdp/fdp-o#MetadataRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#isMetadataOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#isMetadataOf">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#MetadataRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#metadataCatalog -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataCatalog">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <rdfs:label>Metadata catalog</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/dcat#catalog"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#metadataIdentifier -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#servesMetadata -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#servesMetadata">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/dcat#servesDataset"/>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#MetadataService"/>
        <rdfs:range rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:label>serves metadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#validatedAgainst -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#validatedAgainst">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">validated against</rdfs:label>
        <dct:description xml:lang="en">The exact, immutable metadata-profile version a metadata record was validated against at write time. Complements dct:conformsTo (the stable profile) on the record itself; stated on the record's meta-metadata.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#childLink -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#childLink">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#ResourceDefinition"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">child link</rdfs:label>
        <dct:description xml:lang="en">Links a resource definition to the description of one child resource type it may contain (its relation predicate, target type, and display title).</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#relationUri -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#relationUri">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation URI</rdfs:label>
        <dct:description xml:lang="en">The predicate a parent metadata record uses to point at members of the child resource type described by this child link.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#childTagsUri -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#childTagsUri">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">child tags URI</rdfs:label>
        <dct:description xml:lang="en">Optional predicate naming the tag vocabulary used to facet a child listing.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasMetaMetadata -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasMetaMetadata">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has meta-metadata</rdfs:label>
        <dct:description xml:lang="en">RFC 8288 extension link relation: the target is the record's meta-metadata document (provenance, versioning, publication state). Used in HTTP Link headers for in-band affordance advertisement.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasSpec -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasSpec">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has spec</rdfs:label>
        <dct:description xml:lang="en">RFC 8288 extension link relation: the target is the SHACL document that validates this record (instance- or type-level).</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasExpandedView -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasExpandedView">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has expanded view</rdfs:label>
        <dct:description xml:lang="en">RFC 8288 extension link relation: the target is a denormalized view of the record embedding its children summaries.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasStateTransition -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasStateTransition">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has state transition</rdfs:label>
        <dct:description xml:lang="en">RFC 8288 extension link relation: the target is the endpoint accepting publication-state transitions for the record.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasMemberPage -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasMemberPage">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has member page</rdfs:label>
        <dct:description xml:lang="en">RFC 8288 extension link relation: the target is a paged listing of one child type of a container record.</dct:description>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#hasResourceDefinitions -->

    <owl:ObjectProperty rdf:about="https://w3id.org/fdp/fdp-o#hasResourceDefinitions">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has resource definitions</rdfs:label>
        <dct:description xml:lang="en">RFC 8288 extension link relation: the target is the FDP's machine-readable catalog of the resource types it serves. Advertised on the root record.</dct:description>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/date -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/date"/>
    


    <!-- http://rdf.biosemantics.org/ontologies/fdp-o#metadataIssued -->

    <owl:DatatypeProperty rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#metadataIssued">
        <owl:equivalentProperty rdf:resource="https://w3id.org/fdp/fdp-o#metadataIssued"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.biosemantics.org/ontologies/fdp-o#metadataModified -->

    <owl:DatatypeProperty rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#metadataModified">
        <owl:equivalentProperty rdf:resource="https://w3id.org/fdp/fdp-o#metadataModified"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#fdpEndDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpEndDate">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#fdpSoftwareVersion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpSoftwareVersion">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#fdpStartDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpStartDate">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#fdpUILanguage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#fdpUILanguage">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#FAIRDataPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#metadataIssued -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataIssued">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#metadataModified -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataModified">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/date"/>
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#metadataVersion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metadataVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#metadataState -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#metadataState">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metadata state</rdfs:label>
        <dct:description xml:lang="en">The publication state of a metadata record: one of DRAFT, PUBLISHED, or ARCHIVED. PUBLISHED records are visible to any authorized reader; other states only to the record's curators. Stated on the record's meta-metadata.</dct:description>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#allowedStateTransition -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#allowedStateTransition">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">allowed state transition</rdfs:label>
        <dct:description xml:lang="en">A publication state the record may transition to next, per the serving FDP's state machine. An affordance computed at serve time on the meta-metadata representation, not a stored fact.</dct:description>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#urlPrefix -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#urlPrefix">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#ResourceDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">URL prefix</rdfs:label>
        <dct:description xml:lang="en">The route segment a resource type is exposed under by the serving FDP; the empty string denotes the root.</dct:description>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#name -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#name">
        <rdfs:domain rdf:resource="https://w3id.org/fdp/fdp-o#ResourceDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name</rdfs:label>
        <dct:description xml:lang="en">The display name of the resource type described by a resource definition.</dct:description>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#childTarget -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#childTarget">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">child target</rdfs:label>
        <dct:description xml:lang="en">The urlPrefix of the child's resource definition, identifying the target type of a child link.</dct:description>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/fdp/fdp-o#childTitle -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/fdp/fdp-o#childTitle">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">child title</rdfs:label>
        <dct:description xml:lang="en">Human-readable label for a child listing.</dct:description>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rdf.biosemantics.org/ontologies/fdp-o#DataRecord -->

    <owl:Class rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#DataRecord">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fdp/fdp-o#DeprecatedClasses"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://rdf.biosemantics.org/ontologies/fdp-o#Metadata -->

    <owl:Class rdf:about="http://rdf.biosemantics.org/ontologies/fdp-o#Metadata">
        <owl:equivalentClass rdf:resource="https://w3id.org/fdp/fdp-o#Metadata"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/fdp/fdp-o#DeprecatedClasses"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://www.re3data.org/schema/3-0#Repository -->

    <owl:Class rdf:about="http://www.re3data.org/schema/3-0#Repository">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/dcat#Catalog -->

    <owl:Class rdf:about="http://www.w3.org/ns/dcat#Catalog"/>
    


    <!-- http://www.w3.org/ns/dcat#DataService -->

    <owl:Class rdf:about="http://www.w3.org/ns/dcat#DataService"/>
    


    <!-- http://www.w3.org/ns/dcat#Dataset -->

    <owl:Class rdf:about="http://www.w3.org/ns/dcat#Dataset">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/dcat#Resource -->

    <owl:Class rdf:about="http://www.w3.org/ns/dcat#Resource"/>
    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://w3id.org/fdp/fdp-o#DeprecatedClasses -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#DeprecatedClasses"/>
    


    <!-- https://w3id.org/fdp/fdp-o#FAIRDataPoint -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#FAIRDataPoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fdp/fdp-o#MetadataService"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FAIR Data Point</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.re3data.org/schema/3-0#Repository"/>
    </owl:Class>
    


    <!-- https://w3id.org/fdp/fdp-o#Metadata -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#Metadata">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dc:creator rdf:resource="http://orcid.org/0000-0002-1164-1351"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-25T10:09:40Z</dc:date>
    </owl:Class>
    


    <!-- https://w3id.org/fdp/fdp-o#MetadataRecord -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#MetadataRecord">
        <rdfs:label xml:lang="en">Metadata Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fdp/fdp-o#MetadataService -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#MetadataService">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In the context of FAIR Data Point these two classes can be treated as exactMatch. Since class Repository has been used in version 1 of FDP specs</rdfs:comment>
        <rdfs:label>Metadata service</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.re3data.org/schema/3-0#Repository"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- https://w3id.org/fdp/fdp-o#ResourceDefinition -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#ResourceDefinition">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resource Definition</rdfs:label>
        <dct:description xml:lang="en">A resource type a FAIR Data Point serves: its route segment, display name, validating SHACL shape, and the child types its instances may contain.</dct:description>
    </owl:Class>
    


    <!-- https://w3id.org/fdp/fdp-o#ManagedLicense -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#ManagedLicense">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Managed License</rdfs:label>
        <dct:description xml:lang="en">Marker class for license documents managed by (stored in) a FAIR Data Point, used to validate their descriptive contract uniformly.</dct:description>
    </owl:Class>
    


    <!-- https://w3id.org/fdp/fdp-o#CreateOperation -->

    <owl:Class rdf:about="https://w3id.org/fdp/fdp-o#CreateOperation">
